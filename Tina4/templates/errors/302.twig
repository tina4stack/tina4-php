{% extends "errors/base.twig" %}
{#
  Allow only a same-site relative path or an explicit http/https target as the
  redirect. Anything else (javascript:, data:, vbscript:, a scheme-relative //host
  takeover, or an empty value) collapses to "/", so a tainted redirect_url can
  neither run script via the href nor bounce the user off-site. The guard is set
  inside each block because a {% set %} outside a block in an extending template
  does not reach the blocks.
#}
{% block title %}Redirecting…{% endblock %}
{% block meta %}{% set p1 = redirect_url|slice(0,1) %}{% set p2 = redirect_url|slice(0,2) %}{% set p7 = redirect_url|slice(0,7) %}{% set p8 = redirect_url|slice(0,8) %}{% set rel = (p1 == '/') ? ((p2 == '//') ? 'no' : 'yes') : 'no' %}{% set safe_redirect_url = (rel == 'yes' or p7 == 'http://' or p8 == 'https://') ? redirect_url : '/' %}<meta http-equiv="refresh" content="0;url={{ safe_redirect_url }}">{% endblock %}
{% block extra_styles %}
.spinner { display: inline-block; width: 1.5rem; height: 1.5rem; border: 3px solid var(--border); border-top-color: var(--primary); border-radius: 50%; animation: spin 0.8s linear infinite; margin-bottom: 1rem; }
@keyframes spin { to { transform: rotate(360deg); } }
{% endblock %}
{% block content %}
    {% set p1 = redirect_url|slice(0,1) %}{% set p2 = redirect_url|slice(0,2) %}{% set p7 = redirect_url|slice(0,7) %}{% set p8 = redirect_url|slice(0,8) %}{% set rel = (p1 == '/') ? ((p2 == '//') ? 'no' : 'yes') : 'no' %}{% set safe_redirect_url = (rel == 'yes' or p7 == 'http://' or p8 == 'https://') ? redirect_url : '/' %}
    <div class="spinner"></div>
    <div class="error-title">Redirecting…</div>
    <div class="error-msg">You are being redirected to a new location.</div>
    <div class="error-path c-primary">{{ safe_redirect_url }}</div>
    <a href="{{ safe_redirect_url }}" class="error-home">Click here if not redirected</a>
{% endblock %}
