{
  "_comment": [
    "SHARED FIXTURE - identical bytes in all four frameworks.",
    "  tina4-python/tests/fixtures/database_url_corpus.json",
    "  tina4-php/tests/fixtures/database_url_corpus.json",
    "  tina4-ruby/spec/fixtures/database_url_corpus.json",
    "  tina4-nodejs/test/fixtures/database_url_corpus.json",
    "",
    "One answer key for feature 5 of the feature audit (DATABASE_URL parser).",
    "Core Principle 6 says a connection string must mean literally the same thing",
    "in every framework; before this fixture there was nothing that could prove it,",
    "because two of the four had no parser to call without opening a connection.",
    "",
    "Every case is a pure string-to-struct assertion. No database, no socket, no",
    "driver import. A null means the field is absent, NOT an empty string.",
    "",
    "'safe' is toSafeString(): the input URL with the password replaced by ***.",
    "It round-trips, which is what makes it safe to put in a log line - the only",
    "form of a connection URL allowed in a log or an error message."
  ],

  "default_ports": {
    "postgres": 5432,
    "mysql": 3306,
    "mssql": 1433,
    "firebird": 3050
  },

  "_alias_note": [
    "sqlite3 IS an accepted alias and normalises to the `sqlite` engine (owner",
    "decision, 2026-07-30). The driver is literally named sqlite3 in every",
    "framework - Python's sqlite3 module, Ruby's sqlite3 gem, PHP's ext-sqlite3,",
    "Node's node:sqlite - so a user typing the name of the thing they installed",
    "must not hit an exception. The '3' is the file-format version, not a",
    "different engine, so the canonical ENGINE name stays `sqlite` and only the",
    "accepted INPUT is widened.",
    "",
    "This reverses PHP's v3 removal, which had a test asserting sqlite3:// raised",
    "while Ruby accepted it happily - a divergence only cross-framework reading",
    "exposes. tina4-php/CLAUDE.md still lists sqlite3 and pgsql as 'removed'; both",
    "claims are now wrong and the page needs correcting."
  ],

  "aliases": {
    "postgresql": "postgres",
    "pgsql": "postgres",
    "sqlserver": "mssql",
    "sqlite3": "sqlite"
  },

  "cases": [
    {
      "name": "sqlite_file_url_populates_database",
      "url": "sqlite:///app.db",
      "engine": "sqlite", "host": null, "port": null,
      "database": "app.db", "username": null, "password": null,
      "safe": "sqlite:///app.db"
    },
    {
      "name": "sqlite_absolute_file",
      "url": "sqlite:////var/data/app.db",
      "engine": "sqlite", "host": null, "port": null,
      "database": "/var/data/app.db", "username": null, "password": null,
      "safe": "sqlite:////var/data/app.db"
    },
    {
      "name": "sqlite_memory_short_form",
      "url": "sqlite::memory:",
      "engine": "sqlite", "host": null, "port": null,
      "database": ":memory:", "username": null, "password": null,
      "safe": "sqlite:///:memory:"
    },
    {
      "name": "sqlite_memory_path_form",
      "url": "sqlite:///:memory:",
      "engine": "sqlite", "host": null, "port": null,
      "database": ":memory:", "username": null, "password": null,
      "safe": "sqlite:///:memory:"
    },
    {
      "name": "postgres_full_credentials_and_port",
      "url": "postgres://user:pass@localhost:5432/mydb",
      "engine": "postgres", "host": "localhost", "port": 5432,
      "database": "mydb", "username": "user", "password": "pass",
      "safe": "postgres://user:***@localhost:5432/mydb"
    },
    {
      "name": "a_url_without_a_port_gets_the_engine_default",
      "url": "postgresql://localhost/mydb",
      "engine": "postgres", "host": "localhost", "port": 5432,
      "database": "mydb", "username": null, "password": null,
      "safe": "postgres://localhost:5432/mydb"
    },
    {
      "name": "pgsql_alias_resolves_to_postgres",
      "url": "pgsql://localhost:5432/mydb",
      "engine": "postgres", "host": "localhost", "port": 5432,
      "database": "mydb", "username": null, "password": null,
      "safe": "postgres://localhost:5432/mydb"
    },
    {
      "name": "mysql_full",
      "url": "mysql://root:secret@localhost:3306/db",
      "engine": "mysql", "host": "localhost", "port": 3306,
      "database": "db", "username": "root", "password": "secret",
      "safe": "mysql://root:***@localhost:3306/db"
    },
    {
      "name": "mysql_default_port",
      "url": "mysql://localhost/db",
      "engine": "mysql", "host": "localhost", "port": 3306,
      "database": "db", "username": null, "password": null,
      "safe": "mysql://localhost:3306/db"
    },
    {
      "name": "mssql_full",
      "url": "mssql://sa:pw@localhost:1433/db",
      "engine": "mssql", "host": "localhost", "port": 1433,
      "database": "db", "username": "sa", "password": "pw",
      "safe": "mssql://sa:***@localhost:1433/db"
    },
    {
      "name": "sqlserver_alias_resolves_to_mssql",
      "url": "sqlserver://localhost/db",
      "engine": "mssql", "host": "localhost", "port": 1433,
      "database": "db", "username": null, "password": null,
      "safe": "mssql://localhost:1433/db"
    },
    {
      "name": "firebird_double_slash_yields_the_agreed_absolute_path",
      "_note": "D3, settled 2026-07-30 against live Firebird 5.0.4 on the .99 host. The driver accepts one OR two leading slashes and rejects a relative path outright; exactly one is what the user wrote and the only form that is true as a standalone value. PHP used to eat both slashes, Node kept both.",
      "url": "firebird://localhost:3050//var/lib/firebird/data/tina4test.fdb",
      "engine": "firebird", "host": "localhost", "port": 3050,
      "database": "/var/lib/firebird/data/tina4test.fdb", "username": null, "password": null,
      "safe": "firebird://localhost:3050//var/lib/firebird/data/tina4test.fdb"
    },
    {
      "name": "firebird_relative_path_stays_relative",
      "url": "firebird://localhost:3050/data/app.fdb",
      "engine": "firebird", "host": "localhost", "port": 3050,
      "database": "data/app.fdb", "username": null, "password": null,
      "safe": "firebird://localhost:3050/data/app.fdb"
    },
    {
      "name": "firebird_default_port",
      "url": "firebird://localhost//var/lib/app.fdb",
      "engine": "firebird", "host": "localhost", "port": 3050,
      "database": "/var/lib/app.fdb", "username": null, "password": null,
      "safe": "firebird://localhost:3050//var/lib/app.fdb"
    },
    {
      "name": "percent_encoded_password_is_decoded",
      "url": "postgres://u:p%40ss@localhost:5432/db",
      "engine": "postgres", "host": "localhost", "port": 5432,
      "database": "db", "username": "u", "password": "p@ss",
      "safe": "postgres://u:***@localhost:5432/db"
    },
    {
      "name": "percent_encoded_username_is_decoded",
      "url": "postgres://user%40corp:pw@localhost:5432/db",
      "engine": "postgres", "host": "localhost", "port": 5432,
      "database": "db", "username": "user@corp", "password": "pw",
      "safe": "postgres://user@corp:***@localhost:5432/db"
    },
    {
      "name": "username_without_a_password",
      "url": "postgres://readonly@localhost:5432/db",
      "engine": "postgres", "host": "localhost", "port": 5432,
      "database": "db", "username": "readonly", "password": null,
      "safe": "postgres://readonly@localhost:5432/db"
    }
  ],

  "errors": [
    {
      "name": "an_unknown_scheme_raises_a_named_error",
      "_note": "Never a silent fallback to sqlite. The error names the scheme it did not recognise.",
      "url": "cassandra://localhost:9042/keyspace"
    },
    {
      "name": "a_url_with_no_scheme_raises_a_named_error",
      "url": "localhost:5432/mydb"
    },
    {
      "name": "an_empty_url_raises_a_named_error",
      "url": ""
    }
  ]
}
