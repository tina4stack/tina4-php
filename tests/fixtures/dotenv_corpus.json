        "given": {"target": "$ROOT", "files": {".env": "EMPTY=\nSINGLE='${MISSING}\\n'\nDOUBLE=\"line1\\n${HOST}\"\nHOST=example.com\nUNQUOTED=value # comment\nHASH=\"a # b\"\n"}},
        "when": {"operation": "load_env"},
        "then": {"native": {"EMPTY": "", "SINGLE": "${MISSING}\\n", "DOUBLE": "line1\nexample.com", "HOST": "example.com", "UNQUOTED": "value", "HASH": "a # b"}},
