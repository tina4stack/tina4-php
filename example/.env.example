# ─────────────────────────────────────────
# Tina4 Environment Configuration
# TINA4 — The Intelligent Native Application 4ramework
# Generated by: tina4 env
# ─────────────────────────────────────────

# Server
# TINA4_DEBUG=false  # Enable debug mode (dev toolbar, error overlay, hot-reload)
# TINA4_ENV=development  # Application environment: development, production
# HOST=0.0.0.0  # Legacy bare bind host (precedence varies; prefer TINA4_HOST)
# TINA4_HOST=0.0.0.0  # Preferred server bind host
# PORT=7146  # Legacy bare server port (prefer TINA4_PORT)
# TINA4_PORT=7146  # Server port (per-framework default: PHP 7145, Python 7146, Ruby 7147, Node 7148)
# TINA4_HOST_NAME=                          # Host:port used for localhost detection (default: localhost:<port>)
# CI=                          # Set in CI environments; suppresses dev-secret minting (default: unset)
# TINA4_SUPPRESS=false  # Suppress the startup banner
# TINA4_NO_RELOAD=false  # Disable hot-reload (useful for AI-assisted development)
# TINA4_NO_AI_PORT=false  # Disable the secondary stable AI port (port+1000)
# TINA4_NO_BROWSER=false  # Don't open browser on startup
# TINA4_OVERRIDE_CLIENT=                          # Set 'true' to run without the Rust CLI supervisor, e.g. Docker (default: unset)
# TINA4_ALLOW_LEGACY_ENV=false  # Bypass the legacy bare-env boot guard
# TINA4_TRAILING_SLASH_REDIRECT=false  # 301 redirect to the canonical (trailing-slash) path
# TINA4_TEMPLATE_ROUTING=on  # Automatic template-based routing
# TINA4_TEMPLATE_CACHE_TTL=0  # Frond compiled-template cache TTL in seconds (0 = no caching)
# TINA4_HEALTH_PATH=/__health  # Health-check endpoint path
# TINA4_PUBLIC_DIR=                          # Override the static public directory (default: framework public dir)
# TINA4_ENV_FILE=.env  # Path to the .env file to load
# TINA4_MAX_UPLOAD_SIZE=10485760  # Maximum upload size in bytes (10MB)
# TINA4_DEV_POLL_INTERVAL=3000  # Dev-reload client poll fallback interval in milliseconds
# TINA4_SSE_HEARTBEAT=15  # Server-sent events keep-alive interval in seconds

# Logging
# TINA4_LOG_LEVEL=INFO  # Log level: DEBUG, INFO, WARNING, ERROR
# TINA4_LOG_REQUESTS=                          # Log each request (default: inherits TINA4_DEBUG)
# TINA4_LOG_OUTPUT=stdout  # Log sink: stdout, file, both
# TINA4_LOG_FORMAT=text  # Log format: text or json
# TINA4_LOG_ROTATE_SIZE=10485760  # Bytes before a log file rotates (10MB)
# TINA4_LOG_ROTATE_KEEP=5  # Number of rotated log files to keep
# TINA4_LOG_MAX_SIZE=                          # Legacy alias for TINA4_LOG_ROTATE_SIZE (default: unset)
# TINA4_LOG_KEEP=5  # Legacy alias for TINA4_LOG_ROTATE_KEEP
# TINA4_LOG_FILE=                          # Explicit log file path; forces file output (default: empty)
# TINA4_LOG_DIR=logs  # Log directory
# TINA4_LOG_FUNC=                          # Include the caller function name in log lines
# TINA4_LOG_STRICT=false  # Raise on log-write failure instead of swallowing it

# Database
# TINA4_DATABASE_URL=sqlite:///data/app.db  # Database connection string
# TINA4_DATABASE_USERNAME=                          # Database username (if not in URL)
# TINA4_DATABASE_PASSWORD=                          # Database password (if not in URL)
# TINA4_DB_POOL=0  # Connection pool size (0 = single connection)
# TINA4_AUTOCOMMIT=true  # Auto-commit standalone writes (pool-safe)
# TINA4_DATABASE_FIREBIRD_PATH=                          # Firebird database file path override (default: unset)
# TINA4_ORM_PLURAL_TABLE_NAMES=false  # Pluralize ORM table names

# Cache
# TINA4_DB_CACHE=false  # Enable the persistent cross-request query cache
# TINA4_AUTO_CACHING=false  # Enable request-scoped query caching
# TINA4_DB_CACHE_TTL=30  # Persistent DB query cache TTL in seconds
# TINA4_AUTO_CACHING_TTL=5  # Request-scoped cache TTL in seconds
# TINA4_DB_CACHE_BACKEND=memory  # Persistent DB cache backend: memory, redis, file
# TINA4_DB_CACHE_URL=                          # Persistent DB cache backend URL (default: unset)
# TINA4_CACHE_BACKEND=memory  # Response/KV cache backend: memory, redis, file
# TINA4_CACHE_URL=                          # Cache backend URL (default varies by backend)
# TINA4_CACHE_USERNAME=                          # Cache backend username
# TINA4_CACHE_PASSWORD=                          # Cache backend password
# TINA4_CACHE_TTL=60  # Default response cache TTL in seconds
# TINA4_CACHE_MAX_ENTRIES=1000  # Maximum cached entries
# TINA4_CACHE_DIR=data/cache  # Cache directory (file backend)

# Auth
# TINA4_SECRET=                          # JWT/signing secret (default: dev auto-mints to .env.local; set in production)
# TINA4_API_KEY=                          # Static bearer API key; unset disables key auth
# TINA4_TOKEN_LIMIT=60  # JWT/form-token lifetime in minutes
# TINA4_JWT_ALGORITHM=HS256  # JWT signing algorithm

# Session
# TINA4_SESSION_BACKEND=file  # Session backend: file, redis, valkey, mongodb, database
# TINA4_SESSION_TTL=3600  # Session lifetime in seconds
# TINA4_SESSION_PATH=data/sessions  # File session storage path
# TINA4_SESSION_STRICT=false  # Re-raise on session-backend failure instead of degrading
# TINA4_SESSION_NAME=tina4_session  # Session cookie name
# TINA4_SESSION_SAMESITE=Lax  # Cookie SameSite attribute: Strict, Lax, None
# TINA4_SESSION_HTTPONLY=true  # HttpOnly flag on the session cookie
# TINA4_SESSION_SECURE=false  # Secure flag on the session cookie (auto-forced true when SameSite=None)
# TINA4_SESSION_REDIS_HOST=localhost  # Redis host for session storage
# TINA4_SESSION_REDIS_PORT=6379  # Redis port for session storage
# TINA4_SESSION_REDIS_PASSWORD=                          # Redis session password (default: unset)
# TINA4_SESSION_REDIS_DB=0  # Redis session database index
# TINA4_SESSION_VALKEY_HOST=localhost  # Valkey host for session storage
# TINA4_SESSION_VALKEY_PORT=6379  # Valkey port for session storage
# TINA4_SESSION_VALKEY_PASSWORD=                          # Valkey session password (default: unset)
# TINA4_SESSION_VALKEY_DB=0  # Valkey session database index
# TINA4_SESSION_VALKEY_PREFIX=tina4:session:  # Valkey session key prefix
# TINA4_SESSION_MONGO_URL=mongodb://localhost:27017  # MongoDB session connection URL
# TINA4_SESSION_MONGO_DB=tina4  # MongoDB session database
# TINA4_SESSION_MONGO_COLLECTION=sessions  # MongoDB session collection

# CORS
# TINA4_CORS_ORIGINS=*  # Allowed CORS origins (comma-separated or *)
# TINA4_CORS_METHODS=GET, POST, PUT, DELETE, PATCH, OPTIONS  # Allowed HTTP methods
# TINA4_CORS_HEADERS=Content-Type,Authorization,X-Request-ID  # Allowed request headers
# TINA4_CORS_MAX_AGE=86400  # Preflight cache duration in seconds
# TINA4_CORS_CREDENTIALS=false  # Allow credentials in CORS requests

# Security
# TINA4_FRAME_OPTIONS=SAMEORIGIN  # X-Frame-Options header
# TINA4_HSTS=                          # Strict-Transport-Security max-age (empty = header omitted)
# TINA4_CSP=default-src 'self'  # Content-Security-Policy header
# TINA4_REFERRER_POLICY=strict-origin-when-cross-origin  # Referrer-Policy header
# TINA4_PERMISSIONS_POLICY=camera=(), microphone=(), geolocation=()  # Permissions-Policy header
# TINA4_CSRF=true  # CSRF protection (off only when set to false/0/no)
# TINA4_RATE_LIMIT=100  # Requests allowed per window
# TINA4_RATE_WINDOW=60  # Rate-limit window in seconds

# Localization
# TINA4_LOCALE=en  # Default locale
# TINA4_LOCALE_DIR=src/locales  # Locale files directory

# Mail
# TINA4_MAIL_HOST=localhost  # SMTP server host
# TINA4_MAIL_PORT=587  # SMTP port
# TINA4_MAIL_USERNAME=                          # SMTP username
# TINA4_MAIL_PASSWORD=                          # SMTP password
# TINA4_MAIL_FROM=                          # Default from address (default: inherits username or noreply@localhost)
# TINA4_MAIL_FROM_NAME=                          # Default from display name
# TINA4_MAIL_ENCRYPTION=tls  # SMTP encryption: none, tls, ssl
# TINA4_MAIL_IMAP_HOST=                          # IMAP server host (default: empty)
# TINA4_MAIL_IMAP_PORT=993  # IMAP port
# TINA4_MAIL_IMAP_USERNAME=                          # IMAP username (default: inherits TINA4_MAIL_USERNAME)
# TINA4_MAIL_IMAP_PASSWORD=                          # IMAP password (default: inherits TINA4_MAIL_PASSWORD)
# TINA4_MAIL_IMAP_ENCRYPTION=tls  # IMAP encryption: none, tls, ssl
# TINA4_MAIL_TLS_INSECURE=false  # Allow insecure TLS certificates
# TINA4_MAILBOX_DIR=data/mailbox  # Dev mailbox directory

# Queue
# TINA4_QUEUE_BACKEND=file  # Queue backend: file, rabbitmq, kafka, mongodb
# TINA4_QUEUE_PATH=data/queue  # Queue storage path (file backend)
# TINA4_QUEUE_URL=                          # Unified queue URL for AMQP/Kafka/Mongo (default: unset)
# TINA4_KAFKA_BROKERS=localhost:9092  # Kafka broker list
# TINA4_KAFKA_GROUP_ID=tina4_consumer_group  # Kafka consumer group ID
# TINA4_RABBITMQ_HOST=localhost  # RabbitMQ host
# TINA4_RABBITMQ_PORT=5672  # RabbitMQ port
# TINA4_RABBITMQ_USERNAME=guest  # RabbitMQ username
# TINA4_RABBITMQ_PASSWORD=guest  # RabbitMQ password
# TINA4_RABBITMQ_VHOST=/  # RabbitMQ virtual host
# TINA4_MONGO_URI=                          # MongoDB queue connection URI (default: empty)
# TINA4_MONGO_HOST=localhost  # MongoDB queue host
# TINA4_MONGO_PORT=27017  # MongoDB queue port
# TINA4_MONGO_USERNAME=                          # MongoDB queue username
# TINA4_MONGO_PASSWORD=                          # MongoDB queue password
# TINA4_MONGO_DB=tina4  # MongoDB queue database
# TINA4_MONGO_COLLECTION=tina4_queue  # MongoDB queue collection

# WebSocket
# TINA4_WS_BACKPLANE=                          # WebSocket backplane selector: redis or nats (empty = local-only)
# TINA4_WS_BACKPLANE_URL=redis://localhost:6379  # WebSocket backplane connection URL
# TINA4_WS_ALLOWED_ORIGINS=                          # WebSocket origin allow-list (empty = allow all)
# TINA4_WS_IDLE_TIMEOUT=0  # WebSocket idle reaper timeout in seconds (0 = disabled)
# TINA4_WS_MAX_FRAME_SIZE=1048576  # Maximum WebSocket frame size in bytes (1MB)

# GraphQL
# TINA4_GRAPHQL_ENDPOINT=/graphql  # GraphQL endpoint path
# TINA4_GRAPHQL_AUTO_SCHEMA=true  # Auto-build the GraphQL schema from the ORM
# TINA4_GRAPHQL_MAX_DEPTH=50  # GraphQL selection-depth guard (<= 0 disables)

# Swagger
# TINA4_SWAGGER_ENABLED=                          # Enable the Swagger/OpenAPI UI (default: inherits TINA4_DEBUG)
# TINA4_SWAGGER_TITLE=Tina4 API  # OpenAPI document title
# TINA4_SWAGGER_VERSION=1.0.0  # OpenAPI document version
# TINA4_SWAGGER_DESCRIPTION=                          # OpenAPI document description
# TINA4_SWAGGER_CONTACT_EMAIL=                          # OpenAPI contact email (empty suppresses)
# TINA4_SWAGGER_LICENSE=                          # OpenAPI license name (empty suppresses)

# Misc
# TINA4_SERVICE_DIR=src/services  # Background-service discovery directory
# TINA4_SERVICE_SLEEP=5  # Background-service loop sleep in seconds

# MCP
# TINA4_MCP=                          # Enable built-in MCP dev tools (default: inherits TINA4_DEBUG)
# TINA4_MCP_PORT=                          # Dedicated MCP port (default: framework port + 2000)
# TINA4_MCP_REMOTE=false  # Expose the MCP endpoint remotely

# AI
# TINA4_AI_URL=http://localhost:11437/api/chat  # Dev-admin AI chat endpoint URL
# TINA4_AI_MODEL=qwen2.5-coder:14b  # AI model used for plan generation
# TINA4_RAG_URL=http://localhost:11438  # RAG service URL
# TINA4_RAG_TOPK=4  # RAG top-K retrieval count
# TINA4_VISION_URL=http://localhost:11437/api/chat  # Dev-admin vision service URL
# TINA4_EMBED_URL=http://localhost:11437/api/embeddings  # Dev-admin embedding service URL
# TINA4_IMAGE_URL=http://localhost:11437/api/generate  # Dev-admin image service URL
# TINA4_SUPERVISOR_URL=http://localhost:9999  # Rust supervisor URL
# TINA4_AGENT_PORT=                          # Agent port used to derive the supervisor URL (default: unset)

# Misc
# TINA4_ENABLE_FEEDBACK=false  # Dev-admin feedback widget master switch
# TINA4_FEEDBACK_WHITELIST=                          # Feedback widget user whitelist (comma-separated)
# TINA4_FEEDBACK_DEV_USER=                          # Feedback widget dev-user identity
