# Tina4 — src/public is for static assets only. Never execute or serve code here,
# even if a script is placed in this tree (e.g. an upload). This is defence in
# depth alongside the framework's own static-file guard.
<FilesMatch "\.(?i:ph(p[0-9]?|tml|t|ar|ps)|cgi|pl|py|sh|lua|rb)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
    SetHandler none
</FilesMatch>
<IfModule mod_php.c>
    php_admin_flag engine off
</IfModule>
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .phar
RemoveType .php .phtml .php3 .php4 .php5 .php7 .phar
